{
  "name": "dordam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:new": "supabase migration new",
    "db:seed": "sh scripts/seed.sh",
    "db:push": "supabase db push",
    "worker": "node --env-file-if-exists=.env.local --import tsx workers/cli.ts",
    "worker:dry": "node --env-file-if-exists=.env.local --import tsx workers/dry-run.ts",
    "worker:check": "node --env-file-if-exists=.env.local --import tsx workers/check.ts",
    "worker:ai-check": "AI_READ_VERBOSE=1 node --env-file-if-exists=.env.local --import tsx workers/ai-check.ts",
    "store:scan": "node --env-file-if-exists=.env.local --import tsx workers/scan.ts",
    "store:special": "node --env-file-if-exists=.env.local --import tsx scripts/special-stores.ts",
    "catalog:specs": "node scripts/fetch-specs.mjs",
    "catalog:build": "node --import tsx scripts/import-catalog.mjs",
    "build:data": "node --env-file-if-exists=.env.local --import tsx scripts/build-data.ts",
    "prebuild": "npm run build:data",
    "predev": "npm run build:data"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.64.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
