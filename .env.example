# Supabase → Project Settings → API. Leave empty to run on the bundled sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public address of the site, used for SEO links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://dordam.app
# Admin login used only when Supabase is not connected (demo mode).
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@dordam.test
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=dordam-demo
# Cloudflare Turnstile site key for the admin login (secret key goes in Supabase → Authentication → Attack Protection).
# Leave empty to log in without the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Web push for price-drop alerts: npx web-push generate-vapid-keys. Public key on the site, private key only in the worker.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# LLM for the worker (any OpenAI-compatible API). Used when Supabase is not connected;
# later the admin panel's saved settings win.
# Gemini example: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
